{
  "name": "python-forge",
  "productName": "Python Forge",
  "version": "1.0.0",
  "description": "Learn Python from beginner to advanced, then AI, machine learning and game AI — with deep, interactive lessons and a built-in Python runtime.",
  "author": "Python Forge",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-content.ts",
    "check": "npm run typecheck && npm run validate && npm run run-examples",
    "electron:dev": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "run-examples": "tsx scripts/run-examples.ts",
    "postinstall": "node scripts/copy-pyodide.mjs",
    "scaffold": "node scripts/scaffold-curriculum.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "katex": "^0.16.47",
    "pyodide": "^314.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  }
}
